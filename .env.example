# AWS Configuration
# Get these from AWS Console → IAM → Users → Security Credentials
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=us-east-1

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here-change-in-production

# Application Configuration
BANK_OPS_PORT=5009
VERIFICATION_PORT=5010
CORE_BANKING_PORT=5011

# Database Configuration
DATABASE_PATH=../mock_databases/
DMF_DATABASE=dmf_mock.db
FINANCIAL_ACCOUNTS_DATABASE=financial_accounts.db
FRAUD_DATABASE=fraud_indicators.db

# Upload Configuration
UPLOAD_FOLDER=uploads
MAX_UPLOAD_SIZE=16777216  # 16MB in bytes
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg

# Logging
LOG_LEVEL=INFO
LOG_FILE=benebridge.log

# Optional: Email Notifications (not implemented in POC)
# EMAIL_ENABLED=False
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# EMAIL_USER=your-email@example.com
# EMAIL_PASSWORD=your-email-password

# Optional: Production Settings (not used in development)
# PRODUCTION=False
# USE_HTTPS=True
# CERT_FILE=path/to/cert.pem
# KEY_FILE=path/to/key.pem
