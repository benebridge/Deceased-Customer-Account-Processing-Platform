# Large binary files (keep templates, not all generated documents)
# We'll keep a few sample cases but not all 700+ synthetic cases
synthetic_cases/

# Generated files (users will regenerate these)
Generated_Claim_Forms/
Generated_Driver_Licenses/

# Large PDFs (keep templates only)
*.pdf
!*template*.pdf
!*Template*.pdf
# But allow PDFs in Cases folder (test data)
!Cases/**/*.pdf

# Large images (keep templates only)
*.png
!*template*.png
!*Template*.png
!*Blank*.png
# But allow images in Cases folder (test data)
!Cases/**/*.png
!Cases/**/*.jpg
!Cases/**/*.jpeg

# Test outputs
test_case/
test_template_case/

